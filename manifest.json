{
  "manifest_version": 3,
  "name": "Sidebar Translator",
  "version": "1.0.0",
  "description": "基于 DeepL 的侧边栏翻译工具",
  "sidebar_action": {
    "default_title": "Translator",
    "default_panel": "sidebar.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
